# Keep golden snapshots byte-stable across Windows and Unix checkouts.
internal/tui/testdata/** text eol=lf
*.golden text eol=lf

# Go sources stay LF for gofmt / CI format checks.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# README recordings are binary; never let autocrlf touch them. The VHS scripts
# that produce them are shell-adjacent, so they stay LF too.
*.gif binary
*.tape text eol=lf
